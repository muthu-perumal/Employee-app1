# Free AI for Publish Tracker assistant
AI_PROVIDER=auto

# Groq — recommended, generous free tier: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter — free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemma-3-12b-it:free

# Google Gemini — https://aistudio.google.com/apikey (key starts with AIza)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Local Ollama (optional)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Set AI_PROVIDER=none to use database-only answers

# Patch summary service — POST /api/chatbot (Publish Tracker AI Summary tab)
# Local: http://127.0.0.1:8000  |  deployed: http://52.172.32.88:8081
SUMMARY_API_URL=http://52.172.32.88:8081

# SMTP — WorkHub email notifications (Google Workspace app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@ezofis.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME=EZOFIS WorkHub
SMTP_FROM_EMAIL=notifications@ezofis.com
# Default notification inbox (comma-separated for multiple)
TASK_APP_NOTIFY_EMAIL=ezallindia@ezofis.com
# Set to true to also email every employee with status=active
TASK_APP_NOTIFY_ALL_ACTIVE=false
APP_PUBLIC_URL=https://ez-emp-ui.azurewebsites.net
SMTP_TLS_REJECT_UNAUTHORIZED=false
