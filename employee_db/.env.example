# Free AI for Publish Tracker assistant
AI_PROVIDER=auto

# Groq — recommended, generous free tier: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter — free models: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemma-3-12b-it:free

# Google Gemini — https://aistudio.google.com/apikey (key starts with AIza)
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# Local Ollama (optional)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Set AI_PROVIDER=none to use database-only answers
